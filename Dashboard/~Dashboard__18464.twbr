      <column caption='Recent Total Customers' datatype='integer' name='[Calculation_1286622149355831300]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    MONTH([Purchase Month (copy)_1827898529520033792]) = 11 AND YEAR([Purchase Month (copy)_1827898529520033792]) = 2011&#13;&#10;THEN&#13;&#10;    [Total Customer]&#13;&#10;END' />
      </column>
      <column caption='# Customer Prev Month' datatype='integer' name='[Calculation_1286622149356871685]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF &#13;&#10;    DATETRUNC(&#13;&#10;                 &apos;month&apos;,&#13;&#10;                 [Purchase Month (copy)_1827898529520033792]&#13;&#10;              )  = &#13;&#10;     DATEADD(&apos;month&apos;, -2, {FIXED : MAX(DATETRUNC(&apos;month&apos;, [Purchase Month (copy)_1827898529520033792])) })&#13;&#10;THEN&#13;&#10;    [Total Customer]&#13;&#10;END' />
      </column>
      <column caption='Cust Diff Color Flag' datatype='string' name='[Calculation_1742893086618423296]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='If &#13;&#10;    [Cust Diff] &lt; 0 THEN &quot;Negative&quot;&#13;&#10;ELSE&#13;&#10;       &quot;Positive&quot;&#13;&#10;END' />
      </column>
      <column caption='Churn Rate' datatype='real' name='[ChurnRate]' role='measure' type='quantitative' />
