      <column caption='Purchase_Month(Date)' datatype='datetime' datatype-customized='true' name='[Purchase Month (copy)_1827898529520033792]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEPARSE(&apos;yyyy-MM-dd&apos;, [Purchase Month])' />
