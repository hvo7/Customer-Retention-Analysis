            <column caption='Growth %' datatype='real' name='[Calculation_1476662813589504]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Total_Revenue]) - LOOKUP(SUM([Total_Revenue]),-1)) / LOOKUP(SUM([Total_Revenue]),-1)'>
