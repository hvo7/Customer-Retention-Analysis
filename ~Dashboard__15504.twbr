      <column caption='Avg Returner Rate' datatype='real' name='[Avg_Returner_Rate]' role='measure' type='quantitative' />
      <column caption='InvoiceDate (Converted)' datatype='date' name='[Calculation_686517529443479552]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(DATEADD(&apos;day&apos;, INT([InvoiceDate]), #1899-12-30#))' />
      </column>
      <column caption='Max(InvoiceDate)' datatype='datetime' name='[Calculation_686517529443651585]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [CustomerID] : MAX([InvoiceDate])}' />
      </column>
      <column caption='Last Purchase Date' datatype='datetime' name='[Calculation_686517529451843588]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,{FIXED [CustomerID] : Max(InvoiceDate)})' />
      </column>
      <column caption='SwitchProductParam' datatype='real' name='[Calculation_987695759843782656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ([Parameters].[Parameter 1]) = &apos;Avg_Returner_Rate&apos; THEN SUM([Avg_Returner_Rate])&#13;&#10;ELSEIF ([Parameters].[Parameter 1]) = &apos;Total Revenue Non Repeat&apos; THEN SUM([Total_Revenue_Non_Repeat])&#13;&#10;ELSEIF ([Parameters].[Parameter 1]) = &apos;Total Revenue Repeat&apos; THEN SUM([Total_Revenue_Repeat])&#13;&#10;END' />
      </column>
